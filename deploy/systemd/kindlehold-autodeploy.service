# Installed by deploy/scripts/install-auto-deploy.sh (it fills in @USER@ and @REPO@).
[Unit]
Description=Kindlehold auto-deploy: publish the newest main from GitHub
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=@USER@
WorkingDirectory=@REPO@
Environment=HOME=@HOME@
# optional: KINDLEHOLD_NOTIFY_URL=https://ntfy.sh/<your-topic> for a push message on every deploy
EnvironmentFile=-@REPO@/.deploy-local/auto-deploy.env
ExecStart=@REPO@/deploy/scripts/auto-deploy.sh
TimeoutStartSec=30min
Nice=10
