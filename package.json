{
  "name": "kindlehold",
  "version": "0.1.0",
  "private": true,
  "description": "Kindlehold \u2014 an original browser-based medieval settlement-building RTS vertical slice.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5180 --strictPort",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5181 --strictPort",
    "test": "node --test \"tests/unit/**/*.test.js\" \"tests/integration/**/*.test.js\" \"tests/simulation/**/*.test.js\"",
    "test:unit": "node --test \"tests/unit/**/*.test.js\"",
    "test:sim": "node --test \"tests/simulation/**/*.test.js\"",
    "verify": "node scripts/verification/verify.mjs",
    "verify:quick": "node scripts/verification/verify.mjs --presets=midday-overview",
    "test:e2e": "node scripts/verification/e2e.mjs",
    "test:perf": "node scripts/verification/perf.mjs",
    "test:deploy": "bash scripts/deployment/validate-nginx.sh",
    "check": "npm test && npm run build && npm run verify && npm run test:e2e"
  },
  "dependencies": {
    "three": "^0.186.0"
  },
  "devDependencies": {
    "playwright": "^1.62.1",
    "vite": "^8.3.0"
  }
}
