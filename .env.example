# Kindlehold deployment configuration (copy to .env.deploy and adjust; never commit real values)
# Base path the game is served from ("/" for a domain root, "/kindlehold/" for a subpath)
KINDLEHOLD_BASE=/
# Remote host for deploy.sh (SSH alias from ~/.ssh/config recommended; no credentials here)
DEPLOY_HOST=my-vps
# Remote directory that will contain releases/ and current -> releases/<id>
DEPLOY_ROOT=/var/www/kindlehold
# Public URL used by the post-deployment health check
HEALTH_URL=https://game.example.com/
# Number of releases to keep
KEEP_RELEASES=5
